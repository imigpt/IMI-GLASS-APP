<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">


    <!-- STORAGE / MEDIA -->


    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" tools:ignore="ScopedStorage" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" tools:ignore="ScopedStorage" />

    <!-- LOCATION -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- INTERNET -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- BLUETOOTH -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="true" />

    <!-- FOREGROUND SERVICE -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />

    <!-- AUDIO -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- CAMERA -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.telephony" android:required="false" />

    <!-- NOTIFICATIONS -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- ACCESSIBILITY -->

    <!-- CONTACTS / CALLS -->
    <!-- Contacts lookup resolves a spoken name ("call Priya") to a number. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!--
        CALL_PHONE and SEND_SMS were removed to comply with Google Play's
        Permissions and APIs that Access Sensitive Information policy: those
        are restricted permissions available only to an app that is the user's
        default Phone/SMS handler, which IMI is not.

        Calling and messaging still work: IMI now hands the request to the
        user's own dialer (ACTION_DIAL) and SMS app (ACTION_SENDTO) with the
        number and message pre-filled, and the user confirms with one tap.
        Neither intent requires a permission.
    -->

    <!-- WIFI -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="s" />

    <!--
        Package visibility (API 30+). Anything we query with getPackageInfo /
        getLaunchIntentForPackage, or launch with an implicit intent, must be
        declared here or it is invisible to us and the launch silently fails.
    -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <package android:name="com.spotify.music" />
        <intent>
            <action android:name="android.media.action.MEDIA_PLAY_FROM_SEARCH" />
        </intent>

        <!-- CALLING: the dialer we hand tel: numbers to -->
        <intent>
            <action android:name="android.intent.action.DIAL" />
            <data android:scheme="tel" />
        </intent>
        <intent>
            <action android:name="android.intent.action.DIAL" />
        </intent>

        <!-- YOUTUBE: app package + its vnd.youtube deep links -->
        <package android:name="com.google.android.youtube" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="vnd.youtube" />
        </intent>

        <!-- MAPS: navigation is launched with setPackage(), so the package must
             be visible or startActivity throws and nothing opens. -->
        <package android:name="com.google.android.apps.maps" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="google.navigation" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="geo" />
        </intent>

        <!-- Browser fallback for http/https launches (YouTube web, maps, etc.) -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:name=".ui.MyApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.GlassesSDKSample"
        android:usesCleartextTraffic="true"
        tools:targetApi="31">

        <!-- SPLASH SCREEN -->
        <!--
            clearTaskOnLaunch was set here, which tore down the running task every
            time the user returned to the app from the launcher: Mark 1's home
            screen was destroyed and Splash ran again. Returning to a minimised app
            must resume it where it was, so the flag is gone. A genuinely cold
            start still goes through Splash normally.
        -->
        <activity
            android:name=".ui.SplashActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.App.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- AUTHENTICATION SCREENS -->
        <!-- Both are still referenced from code (SplashActivity's not-logged-in
             branch and ProfileActivity.performLogout), so they must stay declared:
             while commented out, reaching either path threw
             ActivityNotFoundException and crashed the app. -->
        <activity
            android:name=".LoginActivity"
            android:exported="false" />

        <activity
            android:name=".SignUpActivity"
            android:exported="false" />
        
        <activity
            android:name=".VerifyCodeActivity"
            android:exported="false" />

        <!-- ONBOARDING SCREEN -->
        <activity
            android:name=".ui.OnboardingActivity"
            android:exported="false" />

        <!-- DEVICE SELECTION -->
        <activity
            android:name=".ui.DeviceSelectionActivity"
            android:exported="false" />

        <!-- MARK 1 HOME -->
        <activity
            android:name=".ui.Mark1MainActivity"
            android:exported="false"
            android:launchMode="singleTop" />

        <!-- MAIN SCREEN (Mark 2) -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop" />

        <!-- TOP-LEVEL CAMERA TAB -->
        <activity
            android:name=".CameraActivity"
            android:exported="false"
            android:label="Camera" />

        <!-- TOP-LEVEL SETTINGS TAB -->
        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="Settings" />

        <!-- BATTERY STATUS SCREEN -->
        <activity
            android:name=".BatteryActivity"
            android:exported="false"
            android:label="Battery" />

        <!-- TOP-LEVEL MORE TAB -->
        <activity
            android:name=".MoreActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:label="More" />

        <!-- BIND DEVICE -->
        <activity android:name=".ui.DeviceBindActivity" />

        <!-- USER MEMORY SETTINGS -->
        <activity 
            android:name=".ui.UserMemoryActivity"
            android:exported="false"
            android:label="AI Memory Settings" />

        <!-- 15-QUESTION PROFILE BUILDER -->
        <activity
            android:name=".ui.LetUsKnowYouActivity"
            android:exported="false"
            android:label="Let Us Know You" />

        <!-- PROFILE SCREEN -->
        <activity
            android:name=".ProfileActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:label="Profile" />

        <!-- HELP & SUPPORT SCREEN -->
        <activity
            android:name=".HelpSupportActivity"
            android:exported="false"
            android:label="Help &amp; Support" />

        <!-- GEMINI LIVE CONVERSATION -->
        <activity 
            android:name=".ui.GeminiLiveActivity"
            android:exported="true"
            android:label="Gemini Live Conversation" />

        <!-- VISION CHAT - IMAGE ANALYSIS -->
        <activity 
            android:name=".VisionChatActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:label="Vision Chat" />

        <!-- CHAT - AI CONVERSATION WITH DRAWER -->
        <activity
            android:name=".ui.ChatActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize"
            android:label="Chat" />

        <!-- CONVERSATION HISTORY - ALL USER/AI MESSAGES -->
        <activity
            android:name=".ui.ConversationHistoryActivity"
            android:exported="false"
            android:label="Conversation History" />

        <!-- USER AI SUMMARY - PROFILE SNAPSHOT FROM CONVERSATION + MEMORY -->
        <activity
            android:name=".ui.UserProfileSummaryActivity"
            android:exported="false"
            android:label="User AI Summary" />

        <!-- PROFILE - what IMI knows about the user, and where it came from -->
        <activity
            android:name=".ui.profile.UserProfileActivity"
            android:exported="false"
            android:label="What IMI knows about you" />

        <!-- PROFILE IMPORT - ask the user's own AI what it knows about them -->
        <activity
            android:name=".ui.profile.ProfileImportActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:windowSoftInputMode="adjustResize"
            android:label="Import your profile" />

        <!-- WEB - IN-APP BROWSER (command control arrives in a later module) -->
        <activity
            android:name=".ui.web.WebBrowserActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:windowSoftInputMode="adjustResize"
            android:label="Web" />

        <!-- SIGNED-IN SITES - pre-authenticate sites the browser agent acts on -->
        <activity
            android:name=".ui.web.SignInAccountsActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:label="Signed-in sites" />

        <!-- QUICK NOTES - USER NOTES AND AI REMINDERS -->
        <activity
            android:name=".ui.QuickNotesActivity"
            android:exported="false"
            android:label="Quick Notes" />

        <activity
            android:name=".ui.NoteEditorActivity"
            android:exported="false"
            android:label="Note"
            android:windowSoftInputMode="adjustResize" />
            
        <!-- MEETING MINUTES - SPEECH-TO-TEXT AND SUMMARIZATION -->
        <activity
            android:name=".ui.MeetingMinutesActivity"
            android:exported="false"
            android:label="Meeting Minutes" />
            
        <activity
            android:name=".ui.ActiveMeetingActivity"
            android:exported="false"
            android:label="Recording Meeting" />

        <activity
            android:name=".ui.AllMeetingMinutesActivity"
            android:exported="false"
            android:label="All Meetings" />


            <!-- GLASS MEDIA GALLERY -->
            <activity
                android:name=".ui.gallery.GlassMediaGalleryActivity"
                android:exported="false"
                android:label="Glass Media Gallery" />

            <!-- LIVE GALLERY – locally captured photos from glasses -->
            <activity
                android:name=".ui.gallery.LiveGalleryActivity"
                android:exported="false"
                android:label="Live Gallery" />

            <!-- IMAGE VIEWER - Full screen in-app image viewer -->
            <activity
                android:name=".ui.gallery.ImageViewerActivity"
                android:exported="false"
                android:theme="@style/Theme.GlassesSDKSample.Fullscreen"
                android:label="Image Viewer" />

            <!-- IMAGE DESCRIPTION VAULT – hidden page (long-press photo count in LiveGallery) -->
            <activity
                android:name=".ui.gallery.ImageDescriptionVaultActivity"
                android:exported="false"
                android:label="Descriptions Vault" />

            <!-- VIDEO PLAYER - Full screen in-app video player -->
            <activity
                android:name=".ui.gallery.VideoPlayerActivity"
                android:exported="false"
                android:theme="@style/Theme.GlassesSDKSample.Fullscreen"
                android:label="Video Player"
                android:configChanges="orientation|screenSize" />

            <!-- FILE PROVIDER FOR SHARING MEDIA -->
            <provider
                android:name="androidx.core.content.FileProvider"
                android:authorities="${applicationId}.fileprovider"
                android:exported="false"
                android:grantUriPermissions="true">
                <meta-data
                    android:name="android.support.FILE_PROVIDER_PATHS"
                    android:resource="@xml/file_paths" />
            </provider>

            <!-- BACKGROUND LISTENING SERVICE (wake-word detection) -->
            <service
                android:name=".ListeningService"
                android:exported="false"
                android:foregroundServiceType="microphone" />

            <!-- GEMINI LIVE BACKGROUND SERVICE (keeps AI audio alive when minimised / screen off) -->
            <service
                android:name=".GeminiBackgroundService"
                android:exported="false"
                android:foregroundServiceType="microphone" />

            <!-- NOTIFICATION LISTENER SERVICE -->
            <service
                android:name=".NotificationListener"
                android:exported="true"
                android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
                <intent-filter>
                    <action android:name="android.service.notification.NotificationListenerService" />
                </intent-filter>
            </service>

            <!--
                The WhatsApp auto-send AccessibilityService was removed to comply
                with Google Play's Accessibility API policy, which requires apps
                to use narrower APIs where one exists. WhatsApp is now opened via
                a wa.me deep link with the message pre-filled instead.
            -->

    </application>

</manifest>
