<?xml version="1.0" encoding="utf-8"?>
<!--
    Outlined speech bubble.

    This was a SOLID filled bubble, which made the chat tab look wrong in the
    bottom nav: tinted orange on the selected tab it read as a hard orange block
    sitting inside the active-indicator pill, rather than as an icon. Every other
    tab icon (home, more, profile) is a light line drawing, so the filled one also
    looked out of place beside them. Same 24dp viewport and same silhouette, drawn
    as an outline with a rounded stroke instead.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2"
        android:strokeLineJoin="round"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M20,3H4C2.9,3 2,3.9 2,5V21L6,17H20C21.1,17 22,16.1 22,15V5C22,3.9 21.1,3 20,3Z" />
</vector>
