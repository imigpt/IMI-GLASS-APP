<?xml version="1.0" encoding="utf-8"?>
<!--
    Glass media gallery: one screen, two modes.
      View     - media already saved on the phone, grouped by day.
      Download - media still on the glasses; pick files and download them.
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gm_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top bar -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="start|center_vertical"
                android:background="@drawable/bg_gm_circle_button"
                android:clickable="true"
                android:contentDescription="Back"
                android:focusable="true"
                android:padding="11dp"
                android:src="@drawable/ic_back"
                app:tint="@color/gm_text_primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="@font/neue_plak_regular"
                android:text="Gallery"
                android:textColor="@color/gm_text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/btnMenu"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="end|center_vertical"
                android:background="@drawable/bg_gm_circle_button"
                android:clickable="true"
                android:contentDescription="Gallery options"
                android:focusable="true"
                android:padding="11dp"
                android:src="@drawable/ic_settings"
                app:tint="@color/gm_text_primary" />
        </FrameLayout>

        <!-- View / Download segmented control -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/bg_gm_segment_track"
            android:orientation="horizontal"
            android:padding="4dp">

            <LinearLayout
                android:id="@+id/tabView"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_gm_segment_active"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/tabViewIcon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_eye"
                    app:tint="@color/gm_on_accent" />

                <TextView
                    android:id="@+id/tabViewLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="@font/neue_plak_regular"
                    android:text="View"
                    android:textColor="@color/gm_on_accent"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tabDownload"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/tabDownloadIcon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_gm_download"
                    app:tint="@color/gm_text_primary" />

                <TextView
                    android:id="@+id/tabDownloadLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="@font/neue_plak_regular"
                    android:text="Download"
                    android:textColor="@color/gm_text_primary"
                    android:textSize="16sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Filter chips -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="16dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chipAll"
                style="@style/GalleryFilterChip"
                android:layout_marginEnd="8dp"
                android:text="All" />

            <TextView
                android:id="@+id/chipImage"
                style="@style/GalleryFilterChip"
                android:layout_marginEnd="8dp"
                android:text="Image" />

            <TextView
                android:id="@+id/chipVideo"
                style="@style/GalleryFilterChip"
                android:layout_marginEnd="8dp"
                android:text="Video" />

            <TextView
                android:id="@+id/chipRecording"
                style="@style/GalleryFilterChip"
                android:text="Recording" />
        </LinearLayout>

        <!-- Download mode: connection status + "select media" header -->
        <LinearLayout
            android:id="@+id/layoutDownloadHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="18dp"
            android:layout_marginEnd="16dp"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/neue_plak_regular"
                    android:text="Select media to download"
                    android:textColor="@color/gm_text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSelectAction"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:fontFamily="@font/neue_plak_regular"
                    android:padding="4dp"
                    android:text="Select all"
                    android:textColor="@color/gm_accent"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:id="@+id/statusDot"
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:background="@drawable/bg_gm_status_dot" />

                <TextView
                    android:id="@+id/tvConnectionStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:fontFamily="@font/neue_plak_regular"
                    android:text="Connected to glasses"
                    android:textColor="@color/gm_text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingStart="12dp"
                android:paddingTop="6dp"
                android:paddingEnd="12dp"
                android:paddingBottom="16dp"
                android:scrollbars="none" />

            <!-- Empty state (no saved media / not connected / nothing on glasses) -->
            <LinearLayout
                android:id="@+id/layoutEmpty"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="40dp"
                android:paddingEnd="40dp"
                android:visibility="gone"
                tools:visibility="visible">

                <ImageView
                    android:id="@+id/ivEmptyIcon"
                    android:layout_width="76dp"
                    android:layout_height="76dp"
                    android:background="@drawable/bg_gm_empty_icon"
                    android:importantForAccessibility="no"
                    android:padding="22dp"
                    android:src="@drawable/ic_gm_download"
                    app:tint="@color/gm_accent" />

                <TextView
                    android:id="@+id/tvEmptyTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:fontFamily="@font/neue_plak_regular"
                    android:gravity="center"
                    android:textColor="@color/gm_text_primary"
                    android:textSize="19sp"
                    android:textStyle="bold"
                    tools:text="Connect your glasses" />

                <TextView
                    android:id="@+id/tvEmptyMessage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/neue_plak_regular"
                    android:gravity="center"
                    android:lineSpacingExtra="3dp"
                    android:textColor="@color/gm_text_secondary"
                    android:textSize="14sp"
                    tools:text="Turn on your glasses and keep them close to your phone." />

                <TextView
                    android:id="@+id/btnEmptyAction"
                    android:layout_width="wrap_content"
                    android:layout_height="52dp"
                    android:layout_marginTop="24dp"
                    android:background="@drawable/bg_gm_button_primary"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/neue_plak_regular"
                    android:gravity="center"
                    android:minWidth="200dp"
                    android:paddingStart="28dp"
                    android:paddingEnd="28dp"
                    android:textColor="@color/gm_on_accent"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    tools:text="Connect to glasses" />
            </LinearLayout>
        </FrameLayout>

        <!-- Bottom action bar: Cancel + Download (n) / Delete (n) -->
        <LinearLayout
            android:id="@+id/layoutActionBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="10dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp"
            android:visibility="gone"
            tools:visibility="visible">

            <LinearLayout
                android:id="@+id/btnCancelSelection"
                android:layout_width="0dp"
                android:layout_height="58dp"
                android:layout_marginEnd="10dp"
                android:layout_weight="1"
                android:background="@drawable/bg_gm_button_secondary"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_close"
                    app:tint="@color/gm_text_primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:fontFamily="@font/neue_plak_regular"
                    android:text="Cancel"
                    android:textColor="@color/gm_text_primary"
                    android:textSize="16sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnPrimaryAction"
                android:layout_width="0dp"
                android:layout_height="58dp"
                android:layout_weight="1.1"
                android:background="@drawable/bg_gm_button_primary"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/ivPrimaryAction"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_gm_download"
                    app:tint="@color/gm_on_accent" />

                <TextView
                    android:id="@+id/tvPrimaryAction"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:fontFamily="@font/neue_plak_regular"
                    android:text="Download (0)"
                    android:textColor="@color/gm_on_accent"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
