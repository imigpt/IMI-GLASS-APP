<?xml version="1.0" encoding="utf-8"?>
<!-- Vision Chat: capture a photo on the glasses and get an AI description. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gm_background"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingBottom="8dp">

    <!-- Everything above the nav pill. SystemBarsInsets pads this column for the
         status bar; padding the fixed-height header instead clipped its buttons. -->
    <LinearLayout
        android:id="@+id/visionContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

    <!-- ============ TOP BAR ============ -->
    <FrameLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="64dp">

        <ImageView
            android:id="@+id/btnVisionBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="start|center_vertical"
            android:background="@drawable/bg_gm_circle_button"
            android:clickable="true"
            android:contentDescription="Back"
            android:focusable="true"
            android:padding="11dp"
            android:src="@drawable/ic_back"
            app:tint="@color/gm_text_primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:fontFamily="@font/neue_plak_regular"
            android:text="Vision Chat"
            android:textColor="@color/gm_text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <ImageView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="end|center_vertical"
            android:background="@drawable/bg_gm_circle_button"
            android:importantForAccessibility="no"
            android:padding="10dp"
            android:src="@drawable/ic_gm_glasses"
            app:tint="@color/gm_accent" />
    </FrameLayout>

    <!-- ============ STATUS PILL ============ -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_vc_status_pill"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="16dp">

        <View
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/bg_gm_step_done" />

        <TextView
            android:id="@+id/ipAddressText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:ellipsize="end"
            android:fontFamily="@font/neue_plak_regular"
            android:maxWidth="280dp"
            android:singleLine="true"
            android:textColor="@color/gm_text_secondary"
            android:textSize="13sp"
            tools:text="Tap Capture to take a photo" />
    </LinearLayout>

    <!-- ============ CHAT MESSAGES ============ -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/visionChatRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:overScrollMode="ifContentScrolls"
        android:paddingTop="12dp"
        android:paddingBottom="8dp"
        android:scrollbars="none" />

    <!-- ============ ACTION BUTTONS ============ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="12dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStopAndReturn"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginEnd="10dp"
            android:layout_weight="1"
            android:background="@drawable/bg_vc_button_secondary"
            android:fontFamily="@font/neue_plak_regular"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="Stop &amp; Return"
            android:textAllCaps="false"
            android:textColor="@color/gm_text_primary"
            android:maxLines="1"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textSize="15sp"
            app:autoSizeMaxTextSize="15sp"
            app:autoSizeMinTextSize="11sp"
            app:autoSizeTextType="uniform"
            app:backgroundTint="@null"
            app:icon="@drawable/ic_close"
            app:iconGravity="textStart"
            app:iconPadding="6dp"
            app:iconSize="18dp"
            app:iconTint="@color/gm_text_primary"
            app:rippleColor="#33FFFFFF" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCaptureFromGlasses"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:background="@drawable/bg_vc_button_primary"
            android:fontFamily="@font/neue_plak_regular"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="Capture"
            android:textAllCaps="false"
            android:textColor="@color/vc_button_primary_content"
            android:maxLines="1"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textSize="15sp"
            app:autoSizeMaxTextSize="15sp"
            app:autoSizeMinTextSize="11sp"
            app:autoSizeTextType="uniform"
            android:textStyle="bold"
            app:backgroundTint="@null"
            app:icon="@drawable/ic_camera"
            app:iconGravity="textStart"
            app:iconPadding="6dp"
            app:iconSize="20dp"
            app:iconTint="@color/vc_button_primary_content"
            app:rippleColor="#33FFFFFF" />

        <!-- Hidden — kept for code compatibility -->
        <Button
            android:id="@+id/btnStartBleStream"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- ============ COMPOSER BAR ============
         Hidden: it isn't wired to anything yet (typing/sending did nothing). -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_chat_composer_v2"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="8dp">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:contentDescription="Add"
                android:src="@drawable/ic_add"
                app:tint="#FFFFFF" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:text="Ask AI"
                android:textColor="#9A9A9A"
                android:textSize="16sp" />

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="4dp"
                android:padding="8dp"
                android:contentDescription="Voice"
                android:src="@drawable/ic_mic"
                app:tint="#CFCFCF" />

            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_chat_send_orb"
                android:contentDescription="Send"
                android:padding="11dp"
                android:src="@drawable/ic_send"
                app:tint="#FFFFFF" />
        </LinearLayout>
    </FrameLayout>

    </LinearLayout>

    <!-- ============ BOTTOM NAVIGATION BAR ============ -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_home_nav"
        app:menu="@menu/menu_bottom_nav_mark1"
        app:itemIconTint="@color/home_nav_item_color"
        app:itemTextColor="@color/home_nav_item_color"
        app:itemActiveIndicatorStyle="@style/HomeNavActiveIndicator"
        app:itemRippleColor="@android:color/transparent"
        app:labelVisibilityMode="unlabeled"
        app:elevation="0dp" />

</LinearLayout>
