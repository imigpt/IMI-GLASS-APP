<?xml version="1.0" encoding="utf-8"?>
<!-- Simple message popup (title, message, up to two buttons) for the glass media gallery. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_gm_dialog"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvDialogTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/neue_plak_regular"
        android:textColor="@color/gm_text_primary"
        android:textSize="20sp"
        android:textStyle="bold"
        tools:text="Couldn't reach your glasses" />

    <TextView
        android:id="@+id/tvDialogMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:fontFamily="@font/neue_plak_regular"
        android:lineSpacingExtra="3dp"
        android:textColor="@color/gm_text_secondary"
        android:textSize="15sp"
        tools:text="Make sure your glasses are on and close to your phone, then try again." />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnDialogSecondary"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginEnd="10dp"
            android:layout_weight="1"
            android:background="@drawable/bg_gm_button_secondary"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/neue_plak_regular"
            android:gravity="center"
            android:textColor="@color/gm_text_primary"
            android:textSize="16sp"
            tools:text="Cancel" />

        <TextView
            android:id="@+id/btnDialogPrimary"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:background="@drawable/bg_gm_button_primary"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/neue_plak_regular"
            android:gravity="center"
            android:textColor="@color/gm_on_accent"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="Try again" />
    </LinearLayout>
</LinearLayout>
