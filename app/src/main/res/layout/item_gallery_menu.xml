<?xml version="1.0" encoding="utf-8"?>
<!-- One row in the gallery settings dropdown. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingEnd="18dp">

    <ImageView
        android:id="@+id/menuIcon"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/bg_gm_menu_icon"
        android:importantForAccessibility="no"
        android:padding="8dp"
        app:tint="@color/gm_accent"
        tools:src="@drawable/ic_gm_download" />

    <TextView
        android:id="@+id/menuLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:fontFamily="@font/neue_plak_regular"
        android:maxLines="1"
        android:textColor="@color/gm_text_primary"
        android:textSize="16sp"
        tools:text="Download from glasses" />
</LinearLayout>
