<?xml version="1.0" encoding="utf-8"?>
<!-- One square tile in the glass media gallery grid. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="4dp">

    <FrameLayout
        android:id="@+id/tileRoot"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_gm_tile"
        android:foreground="?attr/selectableItemBackground"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/imageView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Media thumbnail"
            android:scaleType="centerCrop" />

        <!-- Shown when there is no preview yet (file still on the glasses, or audio) -->
        <LinearLayout
            android:id="@+id/placeholder"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="8dp"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:id="@+id/placeholderIcon"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_gm_image"
                app:tint="#80FFFFFF" />

            <TextView
                android:id="@+id/placeholderName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:ellipsize="middle"
                android:fontFamily="@font/neue_plak_regular"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="@color/gm_text_secondary"
                android:textSize="10sp"
                tools:text="IMG_20260925_1012.jpg" />
        </LinearLayout>

        <!-- Media type badge (top-left) -->
        <ImageView
            android:id="@+id/typeBadge"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_gravity="top|start"
            android:layout_margin="8dp"
            android:background="@drawable/bg_gm_badge"
            android:importantForAccessibility="no"
            android:padding="5dp"
            android:src="@drawable/ic_gm_image"
            app:tint="@color/gm_text_primary" />

        <!-- Selection check (top-right) -->
        <ImageView
            android:id="@+id/checkBadge"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="top|end"
            android:layout_margin="8dp"
            android:background="@drawable/bg_gm_check_off"
            android:importantForAccessibility="no"
            android:padding="4dp"
            android:visibility="gone"
            app:tint="@color/gm_on_accent"
            tools:visibility="visible" />

        <!-- "Saved" pill: already on the phone (Download mode only) -->
        <TextView
            android:id="@+id/savedBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="8dp"
            android:background="@drawable/bg_gm_saved_pill"
            android:fontFamily="@font/neue_plak_regular"
            android:paddingStart="7dp"
            android:paddingTop="2dp"
            android:paddingEnd="7dp"
            android:paddingBottom="2dp"
            android:text="Saved"
            android:textColor="@color/gm_text_primary"
            android:textSize="10sp"
            android:visibility="gone" />

        <!-- Duration (bottom-right, videos) -->
        <TextView
            android:id="@+id/durationBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="8dp"
            android:background="@drawable/bg_gm_badge"
            android:fontFamily="@font/neue_plak_regular"
            android:paddingStart="6dp"
            android:paddingTop="2dp"
            android:paddingEnd="6dp"
            android:paddingBottom="2dp"
            android:textColor="@color/gm_text_primary"
            android:textSize="12sp"
            android:visibility="gone"
            tools:text="00:45"
            tools:visibility="visible" />

        <!-- Yellow outline when selected -->
        <View
            android:id="@+id/selectedOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_gm_tile_selected"
            android:visibility="gone" />
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
