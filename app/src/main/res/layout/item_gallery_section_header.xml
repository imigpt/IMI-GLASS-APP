<?xml version="1.0" encoding="utf-8"?>
<!-- Day header ("Today  ·  32 items") in the glass media gallery grid. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="4dp"
    android:paddingTop="14dp"
    android:paddingEnd="4dp"
    android:paddingBottom="8dp">

    <TextView
        android:id="@+id/tvSectionTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:fontFamily="@font/neue_plak_regular"
        android:textColor="@color/gm_text_primary"
        android:textSize="19sp"
        android:textStyle="bold"
        tools:text="Today" />

    <TextView
        android:id="@+id/tvSectionCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/neue_plak_regular"
        android:textColor="@color/gm_text_secondary"
        android:textSize="14sp"
        tools:text="32 items" />
</LinearLayout>
